# /etc/threattrove/threattrove.env
# chmod 640, owned by threattrove:threattrove
#
# Every var below is optional. With none set, threattrove runs on its eight
# keyless sources and needs no account anywhere.

# --- storage -------------------------------------------------------------
# SQLite database holding the lookup cache, bulk jobs and the local corpus.
TT_DB=/var/lib/threattrove/threattrove.db
# Cache lifetime in seconds (default 7 days).
TT_CACHE_TTL=604800

# --- runtime sizing ------------------------------------------------------
# Per-source HTTP timeout (seconds) and the overall budget for one lookup.
TT_TIMEOUT=20
TT_DEADLINE=45
# Max rows accepted by one bulk job.
TT_BULK_MAX=5000
# Concurrent bulk jobs per web worker.
TT_MAX_JOBS=2
# Upload cap in bytes (default 2 MiB).
TT_MAX_UPLOAD=2097152

# --- web -----------------------------------------------------------------
TT_HOST=127.0.0.1
TT_PORT=8080
TT_WORKERS=2
TT_THREADS=8
# Public base URL, used for canonical links and Open Graph tags.
TT_SITE_URL=https://threattrove.com
# Brand shown in the nav bar, page titles and Open Graph tags.
TT_SITE_NAME=ThreatTrove
# API requests per IP per minute, and page requests per IP per minute.
TT_RATE_LIMIT=60
TT_PAGE_RATE_LIMIT=240

# --- opt-in sources ------------------------------------------------------
# External reverse-IP lookup (shares queried IPs with a third party).
# Leave empty to keep it off; set to 1 to enable the "reverse IP" panel.
TT_ENABLE_REVERSE_IP=
# VirusTotal domain/IP lookups. Off by default: a stray engine flag on a shared
# IP or a popular domain is noise, and the same key's small daily allowance is
# better spent on files and URLs. Set to 1 to restore the old behaviour.
TT_VT_DOMAINS=

# --- provider allowances -------------------------------------------------
# Requests per UTC day the VirusTotal sources may make between them (the free
# public key allows 500/day, 4/min). Once the budget is spent, VirusTotal
# lookups answer "skipped" until the counter resets, instead of erroring.
TT_VT_DAILY_BUDGET=400
# Requests per UTC day the MetaDefender sources may make between them (the
# community key allows 1000/day and 500/hour). 800 leaves headroom so a burst
# of lookups cannot empty the day.
TT_MD_DAILY_BUDGET=800
# Seconds between MetaDefender calls, shared by the file, URL and domain/IP
# endpoints: 7.2 is one call per 500 an hour. Set to 0 on a paid key.
TT_MD_MIN_INTERVAL=7.2

# --- upstream API keys ---------------------------------------------------
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# MetaDefender Cloud (second engine panel): https://metadefender.com/api-info
MD_API_KEY=
# abuse.ch (MalwareBazaar, ThreatFox, URLhaus): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=
# Hybrid Analysis: https://www.hybrid-analysis.com/apikeys/info
HA_API_KEY=
# MalShare: https://malshare.com/doc.php
MALSHARE_API_KEY=
# Triage (tria.ge): https://tria.ge/settings
TRIAGE_API_KEY=
# urlscan.io: https://urlscan.io/user/profile/
URLSCAN_API_KEY=
# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=
# PhishTank application key: https://www.phishtank.com/api_info.php
PHISHTANK_APPKEY=
